# FRS Backend Environment Configuration

# ===========================================
# Authentication & Security
# ===========================================

# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32

# JWT Algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Access token expiration in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# Admin User Seeding
# ===========================================

# Default admin credentials - CHANGE IN PRODUCTION!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@frs.local

# ===========================================
# Database
# ===========================================

# SQLite database path (relative to backend directory)
DATABASE_URL=sqlite:///./data/frs.db

# ===========================================
# Camera Configuration
# ===========================================

# Camera RTSP URL
CAMERA_RTSP_URL=rtsp://admin:password@192.168.1.100:554/stream1

# Camera HTTP URL (for snapshots/controls)
CAMERA_HTTP_URL=http://192.168.1.100

# Camera credentials
CAMERA_USERNAME=admin
CAMERA_PASSWORD=password

# ===========================================
# Application Settings
# ===========================================

# Server host and port
HOST=0.0.0.0
PORT=8000

# Debug mode (disable in production)
DEBUG=false

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
